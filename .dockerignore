frontend/dist
backend/.venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache

# Not needed at runtime
backend/tests
docs
export
web
assets/Cinematic_film_still_*.png
*.log
.DS_Store
