# 净影 CleanFrame 后端环境配置
# 复制为 .env 并填入你的火山引擎 LAS / TOS 凭证

# 执行模式: auto (有 LAS_API_KEY 且有 TOS_BUCKET 则 live，否则 mock) | live | mock
CLEANFRAME_EXECUTION_MODE=auto

# 火山引擎 LAS 算子配置
# 获取方式: 火山引擎 LAS 控制台 -> API Key 管理
LAS_API_KEY=
LAS_REGION=cn-beijing
# 可选覆盖，留空则按 LAS_REGION 自动拼接 https://operator.las.{region}.volces.com/api/v1
LAS_BASE_URL=
# 可选公网异步回调地址 (需 https:// 且不能为 localhost)
LAS_CALLBACK_URL=

# 火山引擎 TOS 对象存储配置（与 LAS 同主账号、同地域）
TOS_BUCKET=
TOS_REGION=cn-beijing
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_INPUT_PREFIX=cleanframe/inputs
TOS_OUTPUT_PREFIX=cleanframe/outputs
VOLC_ACCESS_KEY_ID=
VOLC_ACCESS_KEY_SECRET=

# 并发与轮询配置（火山 LAS 单账号默认并发 10 / 600 RPM）
CLEANFRAME_MAX_CONCURRENCY=10
CLEANFRAME_POLL_INTERVAL=3.0

# 数据库与本地存储
CLEANFRAME_DATABASE_URL=sqlite:///./storage/cleanframe.db
CLEANFRAME_STORAGE_DIR=./storage
CLEANFRAME_PUBLIC_BASE_URL=http://127.0.0.1:8000
